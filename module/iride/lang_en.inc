    { "Iride: riduzione disturbo lunghe esposizioni ACCESA: ogni scatto dura il doppio", "Iride: long exposure noise reduction ON: every shot takes twice as long" },
    { "Istogramma", "Histogram" },
    { "LA TUA PELLICOLA", "YOUR FILM" },
    { "LGHT, DARK, FLAT, BIAS al posto di IMG_", "LGHT, DARK, FLAT, BIAS instead of IMG_" },
